<?xml version="1.0"?>
<clickhouse>
  <!-- Keep file logs useful for incidents without allowing multi-gigabyte rotation. -->
  <logger>
    <level>warning</level>
    <size>100M</size>
    <count>3</count>
  </logger>

  <!-- Disable the server-wide allocator sampler that feeds system.trace_log. -->
  <total_memory_profiler_step>0</total_memory_profiler_step>

  <!-- Langfuse does not consume these high-volume ClickHouse diagnostic logs. -->
  <metric_log remove="1"/>
  <trace_log remove="1"/>
  <text_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <opentelemetry_span_log remove="1"/>
  <processors_profile_log remove="1"/>
  <query_metric_log remove="1"/>
  <background_schedule_pool_log remove="1"/>

  <!-- Retain low-volume operational evidence, but bound it to seven days. -->
  <query_log>
    <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
  </query_log>
  <part_log>
    <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
  </part_log>
  <error_log>
    <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
  </error_log>
</clickhouse>
